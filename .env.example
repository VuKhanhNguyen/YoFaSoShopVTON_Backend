SERVER_PORT=8080
DB_URL=jdbc:mysql://127.0.0.1:3306/yofasoshop_db?connectionTimeZone=UTC
DB_USERNAME=yofaso_app
DB_PASSWORD=CHANGE_ME
MYSQL_ROOT_PASSWORD=CHANGE_ME_SEPARATE_ROOT_PASSWORD
JWT_SECRET=CHANGE_ME_RANDOM_MINIMUM_32_BYTES
AI_SERVICE_BASE_URL=http://127.0.0.1:8000
AI_INTERNAL_API_KEY=CHANGE_ME_SAME_AS_AI
AI_CONNECT_TIMEOUT_SECONDS=5
AI_SUBMIT_TIMEOUT_SECONDS=15
AI_VTON_HTTP_TIMEOUT_SECONDS=15
AI_POLL_INTERVAL_MS=1000
AI_POLL_ENABLED=true
STORAGE_LOCAL_ROOT=./data/storage
BACKEND_RUNTIME_ROOT=./data/runtime
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8081,http://127.0.0.1:8081
RATE_LIMIT_PER_MINUTE=120
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_PHONE=
R2_ACCOUNT_ID=THAY_ACCOUNT_ID
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto
R2_BUCKET_PUBLIC=yofasoshop-catalog
R2_BUCKET_PRIVATE=yofasoshop-private
R2_PUBLIC_BASE_URL=
# Dien HTTPS base URL public catalog khi dung object key trong seed SQL.
# Auth/email/frontend integration
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_APP_PASSWORD=
MAIL_FROM=
OTP_TTL_MINUTES=10
WEB_APP_URL=http://localhost:3000
MOBILE_WEB_URL=http://localhost:8081
BACKEND_PUBLIC_URL=http://localhost:8080
# OAuth2 Social Login (Google & Facebook)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
FACEBOOK_OAUTH_APP_ID=
FACEBOOK_OAUTH_APP_SECRET=
OAUTH_ALLOWED_REDIRECT_PREFIXES=yofasomobile://,exp://,http://localhost:8081,http://127.0.0.1:8081
SEED_TEST_GMAIL=
# Multi-Provider LLM Chatbot & AI Stylist VTON
# Chatbot text uu tien: groq -> gemini -> nvidia -> openrouter
LLM_PROVIDER_ORDER=groq,gemini,nvidia,openrouter
# AI Stylist VTON & tin nhan kem anh uu tien Vision: gemini -> nvidia (4 model vision) -> openrouter
LLM_VISION_PROVIDER_ORDER=gemini,nvidia,openrouter

# 1. Groq (Uu tien 1 Chatbot - doc header x-ratelimit-remaining-requests, <= 5 req chuyen sang Gemini)
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1/chat/completions
GROQ_MODELS=openai/gpt-oss-120b,qwen/qwen3.8-27b,openai/gpt-oss-20b,allam-2-7b
GROQ_MIN_REMAINING_RPD=5

# 2. Google Gemini AI Studio (Uu tien 1 Vision / Uu tien 2 Chatbot - ho tro ca Gemini Flash & Gemma 4 14.4K RPD)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models
GEMINI_MODELS=gemini-3.5-flash-lite,gemini-3.1-flash-lite-preview,gemini-3.8-flash,gemini-3.6-flash,gemini-3-flash-preview,gemini-2.5-flash,gemini-2.5-flash-lite,gemini-4-hydrogen,gemma-4-31b-it,gemma-4-26b-a4b-it
GEMINI_MIN_REMAINING_RPD=2

# 3. NVIDIA NIM (Uu tien 2 Vision [bo qua nemotron-3.5-lightning khi co anh] / Uu tien 3 Chatbot, ~40 RPM)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_MODELS=nvidia/nemotron-3.5-lightning-30b-a3b,z-ai/glm-5.3-flash,minimaxai/minimax-m3.1-flash,mistralai/mistral-large-4-1t-a52b,stepfun-ai/step-5-preview
NVIDIA_MAX_RPM=40

# 4. OpenRouter AI Chatbot (Fallback cuoi - multi-model free)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_MODELS=nvidia/nemotron-3-nano-omni-30b-a3b-reasoning:free,nvidia/nemotron-3.5-super-vl:free,nvidia/nemotron-3.5-lightning:free,nvidia/nemotron-3-ultra-550b-a55b:free,google/gemma-4-31b-it:free,google/gemma-4-26b-a4b-it:free
OPENROUTER_MIN_REMAINING_RPD=2
OPENROUTER_TEMPERATURE=0.2
OPENROUTER_MAX_TOKENS=1500
OPENROUTER_TIMEOUT_SECONDS=25
